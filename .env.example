# ============================================================================
# Mullti-Agent-1 — environment configuration
# Copy this file to `.env` and fill in the keys for the integrations you want
# to take live. Any integration whose keys are missing runs in DEMO mode
# (returns representative sample data) so the whole system is runnable today.
# ============================================================================

# --- Reasoning engine (required) -------------------------------------------
# The brain behind every agent. Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional: override the model (defaults to claude-opus-4-8)
# MULTIAGENT_MODEL=claude-opus-4-8

# Your business context — fed to every agent so output is on-brand.
BUSINESS_NAME=Your Studio
BUSINESS_NICHE=video production and AI content
BUSINESS_HANDLE=@yourhandle

# --- Where results get delivered -------------------------------------------
# Telegram: create a bot via @BotFather, then message it once and get the
# chat id from https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Ayrshare (RECOMMENDED: one key for TikTok + LinkedIn + more) -----------
# Easiest path to live social posting + analytics without the TikTok/LinkedIn
# app-review gauntlet. Sign up at https://www.ayrshare.com, connect your
# TikTok + LinkedIn accounts, and paste the API key here. When set, the TikTok
# and LinkedIn adapters route through Ayrshare automatically.
AYRSHARE_API_KEY=
# Safety: posts are DRY-RUN (composed, not published) unless you set this true.
AYRSHARE_AUTO_POST=false

# --- TikTok (direct, optional — only if NOT using Ayrshare) -----------------
# TikTok for Developers / Content Posting + Display API access token.
TIKTOK_ACCESS_TOKEN=
TIKTOK_OPEN_ID=

# --- LinkedIn (direct, optional — only if NOT using Ayrshare) ---------------
LINKEDIN_ACCESS_TOKEN=

# --- Gmail / Google Workspace (Sheets, Docs) -------------------------------
# Path to an OAuth client_secret.json or a service-account JSON.
GOOGLE_CREDENTIALS_FILE=credentials/google.json
GOOGLE_TOKEN_FILE=credentials/google_token.json
# Default spreadsheet / doc the agents read & write (optional).
LEADS_SHEET_ID=
PERFORMANCE_SHEET_ID=
TAX_SHEET_ID=

# --- Phyllo (optional: deeper audience demographics) -----------------------
# Read-only creator analytics. When set, takes priority over Ayrshare for
# audience demographics in research_audience / weekly_performance_review.
PHYLLO_CLIENT_ID=
PHYLLO_SECRET=
PHYLLO_ACCOUNT_ID=
PHYLLO_ENV=sandbox             # sandbox | staging | production

# --- Stripe ----------------------------------------------------------------
STRIPE_API_KEY=

# --- Web search (brand mentions, trends, competitor research) --------------
# Uses Claude's built-in web search by default (no extra key needed).
# Optionally plug in a dedicated search provider:
# SERPAPI_KEY=
