# systemd unit for the cron scheduler.
# Install:
#   sudo cp deploy/multiagent-scheduler.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now multiagent-scheduler
# Adjust WorkingDirectory / User / paths to match your install.

[Unit]
Description=Mullti-Agent-1 cron scheduler
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=multiagent
WorkingDirectory=/opt/Mullti-Agent-1
EnvironmentFile=/opt/Mullti-Agent-1/.env
ExecStart=/opt/Mullti-Agent-1/.venv/bin/python run.py serve
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
